      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .workspace-scroll::-webkit-scrollbar,.screen-strip::-webkit-scrollbar{height:6px;width:6px}\n  .workspace-scroll::-webkit-scrollbar-thumb,.screen-strip::-webkit-scrollbar-thumb{background:#30363D;border-radius:999px}\n  .workspace-scroll::-webkit-scrollbar-track,.screen-strip::-webkit-scrollbar-track{background:#0D1117}\n  @media (prefers-reduced-motion: reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}\n</style>\n<div class=\"workspace-scroll min-h-screen overflow-x-clip bg-[#0D1117] text-[#F0F6FC] font-[Inter,sans-serif]\" data-kid=\"1\" data-name=\"workspace main container\">\n    <div class=\"mx-auto flex min-h-screen max-w-[1440px] flex-col border-x border-[#30363D] bg-[#0D1117]\" data-kid=\"1-1\" data-name=\"page wrapper\">\n        <header class=\"sticky top-0 z-30 border-b border-[#30363D] bg-[#0D1117]/95 px-5 py-3 backdrop-blur-md sm:px-8\" data-kid=\"1-1-1\" data-name=\"sticky header\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-1-1\" data-name=\"header layout container\">\n                <div class=\"flex min-w-0 items-center gap-3 font-['JetBrains_Mono',monospace] text-[11px] text-[#8B949E]\" data-kid=\"1-1-1-1-1\" data-name=\"repository breadcrumb path\">\n                    <span class=\"hidden h-7 w-7 shrink-0 items-center justify-center rounded-md border border-[#30363D] bg-[#161B22] text-[#3FB950] sm:flex\" data-kid=\"1-1-1-1-1-1\" data-name=\"root directory icon\">\n                        ~/\n                    </span>\n                    <span class=\"truncate\" data-kid=\"1-1-1-1-1-2\" data-name=\"breadcrumb text path\">\n                        kawtar-elg / repositories /\n                        <span class=\"text-[#F0F6FC]\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"repository name text\">\n                            autobrain\n                        </span>\n                    </span>\n                </div>\n                <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-1-2\" data-name=\"header action group\">\n                    <span class=\"hidden items-center gap-2 rounded-full border border-[#30363D] px-2.5 py-1 font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E] sm:flex\" data-kid=\"1-1-1-1-2-1\" data-name=\"repository branch indicator\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#3FB950]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"branch status dot\">\n                        </span>\n                        main\n                    </span>\n                    <button aria-label=\"Close repository view\" class=\"inline-flex items-center gap-2 rounded-md border border-[#30363D] bg-[#161B22] px-3 py-2 text-xs font-semibold text-[#F0F6FC] hover:border-[#7C7CFF] hover:text-[#FFFFFF]\" data-kid=\"1-1-1-1-2-2\" data-name=\"close repository button\">\n                        <svg class=\"h-4 w-4 text-[#8B949E]\" data-kid=\"1-1-1-1-2-2-1\" data-name=\"close icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M6 6l12 12M18 6L6 18\" stroke-linecap=\"round\">\n                            </path>\n                        </svg>\n                        <span class=\"hidden sm:inline\" data-kid=\"1-1-1-1-2-2-2\" data-name=\"close button label\">\n                            Close\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </header>\n        <main class=\"grid flex-1 grid-cols-1 lg:grid-cols-[minmax(0,1fr)_430px]\" data-kid=\"1-1-2\" data-name=\"main layout grid\">\n            <article class=\"min-w-0 border-b border-[#30363D] lg:border-b-0 lg:border-r\" data-kid=\"1-1-2-1\" data-name=\"content column\">\n                <div class=\"border-b border-[#30363D] px-5 py-7 sm:px-8 lg:px-12 lg:py-9\" data-kid=\"1-1-2-1-1\" data-name=\"project metadata header\">\n                    <button class=\"mb-7 inline-flex items-center gap-2 font-['JetBrains_Mono',monospace] text-[11px] text-[#8B949E] hover:text-[#3FB950]\" data-kid=\"1-1-2-1-1-1\" data-name=\"back to repositories button\">\n                        <svg class=\"h-4 w-4\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"back icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M19 12H5M11 18l-6-6 6-6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            </path>\n                        </svg>\n                        Back to repositories\n                    </button>\n                    <div class=\"flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between\" data-kid=\"1-1-2-1-1-2\" data-name=\"project info row\">\n                        <div class=\"flex min-w-0 items-start gap-4\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"logo and title group\">\n                            <div class=\"flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-[#30363D] bg-[#161B22] p-2\" data-kid=\"1-1-2-1-1-2-1-1\" data-name=\"logo image container\">\n                                <img alt=\"AutoBrain logo\" class=\"h-full w-full object-contain\" data-kid=\"1-1-2-1-1-2-1-1-1\" data-name=\"project logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/autobrain-logo.png\"/>\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"1-1-2-1-1-2-1-2\" data-name=\"project title and tags\">\n                                <div class=\"mb-2 flex flex-wrap items-center gap-2\" data-kid=\"1-1-2-1-1-2-1-2-1\" data-name=\"title and visibility tag group\">\n                                    <h1 class=\"font-['JetBrains_Mono',monospace] text-2xl font-semibold tracking-[-0.04em] text-[#F0F6FC] sm:text-3xl\" data-kid=\"1-1-2-1-1-2-1-2-1-1\" data-name=\"project title heading\">\n                                        AutoBrain\n                                    </h1>\n                                    <span class=\"rounded-full border border-[#30363D] px-2 py-0.5 font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E]\" data-kid=\"1-1-2-1-1-2-1-2-1-2\" data-name=\"visibility tag\">\n                                        Public\n                                    </span>\n                                </div>\n                                <p class=\"mb-3 text-sm font-medium text-[#3FB950]\" data-kid=\"1-1-2-1-1-2-1-2-2\" data-name=\"project tagline\">\n                                    AI-Powered Automotive Diagnostics\n                                </p>\n                                <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1 font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E]\" data-kid=\"1-1-2-1-1-2-1-2-3\" data-name=\"tech tags\">\n                                    <span data-kid=\"1-1-2-1-1-2-1-2-3-1\" data-name=\"tech tag 1\">\n                                        mobile\n                                    </span>\n                                    <span class=\"text-[#30363D]\" data-kid=\"1-1-2-1-1-2-1-2-3-2\" data-name=\"tag separator 1\">\n                                        ·\n                                    </span>\n                                    <span data-kid=\"1-1-2-1-1-2-1-2-3-3\" data-name=\"tech tag 2\">\n                                        Kotlin\n                                    </span>\n                                    <span class=\"text-[#30363D]\" data-kid=\"1-1-2-1-1-2-1-2-3-4\" data-name=\"tag separator 2\">\n                                        ·\n                                    </span>\n                                    <span data-kid=\"1-1-2-1-1-2-1-2-3-5\" data-name=\"tech tag 3\">\n                                        AI / ML\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex shrink-0 flex-wrap gap-2\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"project action buttons\">\n                            <a class=\"inline-flex items-center gap-2 rounded-md bg-[#2EA043] px-3 py-2 text-xs font-semibold text-white hover:bg-[#3FB950]\" data-kid=\"1-1-2-1-1-2-2-1\" data-name=\"google play download button\" href=\"https://play.google.com/store/apps/details?id=com.app.autobrain\" rel=\"noreferrer\" target=\"_blank\">\n                                <svg class=\"h-4 w-4\" data-kid=\"1-1-2-1-1-2-2-1-1\" data-name=\"google play icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M5 4.5v15l12-7.5L5 4.5Z\" stroke-linejoin=\"round\">\n                                    </path>\n                                    <path d=\"m5 4.5 9 5.6M5 19.5l9-5.7\" stroke-linecap=\"round\">\n                                    </path>\n                                </svg>\n                                Google Play\n                            </a>\n                            <button class=\"inline-flex items-center gap-2 rounded-md border border-[#30363D] bg-[#161B22] px-3 py-2 text-xs font-semibold text-[#F0F6FC] hover:border-[#7C7CFF] hover:text-[#FFFFFF]\" data-kid=\"1-1-2-1-1-2-2-2\" data-name=\"watch demo button\">\n                                <svg class=\"h-4 w-4 text-[#8B949E]\" data-kid=\"1-1-2-1-1-2-2-2-1\" data-name=\"play icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M8 5v14l11-7L8 5Z\" stroke-linejoin=\"round\">\n                                    </path>\n                                </svg>\n                                Watch demo\n                            </button>\n                            <a class=\"inline-flex items-center gap-2 rounded-md border border-[#30363D] bg-[#161B22] px-3 py-2 text-xs font-semibold text-[#F0F6FC] hover:border-[#7C7CFF] hover:text-[#FFFFFF]\" data-kid=\"1-1-2-1-1-2-2-3\" data-name=\"source code repository button\" href=\"https://github.com/Kawtar-Elg\" rel=\"noreferrer\" target=\"_blank\">\n                                <svg class=\"h-4 w-4 text-[#8B949E]\" data-kid=\"1-1-2-1-1-2-2-3-1\" data-name=\"code icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M8 7h8M8 11h8M8 15h5\" stroke-linecap=\"round\">\n                                    </path>\n                                    <path d=\"M5 3h10l4 4v14H5V3Z\" stroke-linejoin=\"round\">\n                                    </path>\n                                </svg>\n                                Source code\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"border-b border-[#30363D] px-5 py-3 sm:px-8 lg:px-12\" data-kid=\"1-1-2-1-2\" data-name=\"navigation breadcrumb\">\n                    <div class=\"flex items-center gap-3 font-['JetBrains_Mono',monospace] text-[11px] text-[#8B949E]\" data-kid=\"1-1-2-1-2-1\" data-name=\"navigation path\">\n                        <svg class=\"h-4 w-4 text-[#3FB950]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"document icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M5 4h14v16H5z\" stroke-linejoin=\"round\">\n                            </path>\n                            <path d=\"M8 8h8M8 12h6M8 16h4\" stroke-linecap=\"round\">\n                            </path>\n                        </svg>\n                        <span class=\"text-[#F0F6FC]\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"file name\">\n                            README.md\n                        </span>\n                        <span class=\"text-[#30363D]\" data-kid=\"1-1-2-1-2-1-3\" data-name=\"path separator\">\n                            /\n                        </span>\n                        <span data-kid=\"1-1-2-1-2-1-4\" data-name=\"file description\">\n                            AutoBrain case study\n                        </span>\n                    </div>\n                </div>\n                <div class=\"px-5 py-8 sm:px-8 lg:px-12 lg:py-10\" data-kid=\"1-1-2-1-3\" data-name=\"article content area\">\n                    <div class=\"mb-9 rounded-lg border border-[#30363D] bg-[#161B22] p-4 sm:p-5\" data-kid=\"1-1-2-1-3-1\" data-name=\"table of contents card\">\n                        <div class=\"mb-3 flex items-center justify-between gap-4\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"toc header\">\n                            <span class=\"font-['JetBrains_Mono',monospace] text-[10px] uppercase tracking-[0.14em] text-[#8B949E]\" data-kid=\"1-1-2-1-3-1-1-1\" data-name=\"toc label\">\n                                On this page\n                            </span>\n                            <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-1-2\" data-name=\"toc file index\">\n                                README.index\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-x-4 gap-y-2 font-['JetBrains_Mono',monospace] text-[11px] text-[#8B949E] sm:grid-cols-3\" data-kid=\"1-1-2-1-3-1-2\" data-name=\"toc link grid\">\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-1\" data-name=\"toc link overview\" href=\"#overview\">\n                                01 / Overview\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-2\" data-name=\"toc link problem\" href=\"#problem\">\n                                02 / Problem\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-3\" data-name=\"toc link solution\" href=\"#solution\">\n                                03 / Solution\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-4\" data-name=\"toc link features\" href=\"#features\">\n                                04 / Features\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-5\" data-name=\"toc link role\" href=\"#role\">\n                                05 / Role\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-6\" data-name=\"toc link architecture\" href=\"#architecture\">\n                                06 / Architecture\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-7\" data-name=\"toc link technologies\" href=\"#technologies\">\n                                07 / Technologies\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-8\" data-name=\"toc link screens\" href=\"#screens\">\n                                08 / Screens\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-9\" data-name=\"toc link demo\" href=\"#demo\">\n                                09 / Demo\n                            </a>\n                            <a class=\"hover:text-[#3FB950]\" data-kid=\"1-1-2-1-3-1-2-10\" data-name=\"toc link links\" href=\"#links\">\n                                10 / Links\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"space-y-11\" data-kid=\"1-1-2-1-3-2\" data-name=\"content sections\">\n                        <section data-kid=\"1-1-2-1-3-2-1\" data-name=\"overview section\" id=\"overview\">\n                            <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-2-1-3-2-1-1\" data-name=\"section header\">\n                                <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-1-1-1\" data-name=\"section number\">\n                                    01\n                                </span>\n                                <h2 class=\"text-xl font-semibold tracking-[-0.02em] text-[#F0F6FC]\" data-kid=\"1-1-2-1-3-2-1-1-2\" data-name=\"section title\">\n                                    Overview\n                                </h2>\n                            </div>\n                            <p class=\"max-w-2xl text-sm leading-7 text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-1-2\" data-name=\"section text\">\n                                Application de Diagnostic Automobile par Intelligence Artificielle. AutoBrain combines computer vision and AI to analyze vehicle issues and provide instant diagnostic insights.\n                            </p>\n                        </section>\n                        <section class=\"border-t border-[#30363D] pt-8\" data-kid=\"1-1-2-1-3-2-2\" data-name=\"problem section\" id=\"problem\">\n                            <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-2-1-3-2-2-1\" data-name=\"section header\">\n                                <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-2-1-1\" data-name=\"section number\">\n                                    02\n                                </span>\n                                <h2 class=\"text-xl font-semibold tracking-[-0.02em] text-[#F0F6FC]\" data-kid=\"1-1-2-1-3-2-2-1-2\" data-name=\"section title\">\n                                    Problem\n                                </h2>\n                            </div>\n                            <p class=\"max-w-2xl text-sm leading-7 text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-2-2\" data-name=\"section text\">\n                                Car diagnostics are expensive and inaccessible for most people.\n                            </p>\n                        </section>\n                        <section class=\"border-t border-[#30363D] pt-8\" data-kid=\"1-1-2-1-3-2-3\" data-name=\"solution section\" id=\"solution\">\n                            <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-2-1-3-2-3-1\" data-name=\"section header\">\n                                <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-3-1-1\" data-name=\"section number\">\n                                    03\n                                </span>\n                                <h2 class=\"text-xl font-semibold tracking-[-0.02em] text-[#F0F6FC]\" data-kid=\"1-1-2-1-3-2-3-1-2\" data-name=\"section title\">\n                                    Solution\n                                </h2>\n                            </div>\n                            <p class=\"max-w-2xl text-sm leading-7 text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-3-2\" data-name=\"section text\">\n                                A mobile app that uses AI (Gemini API, TensorFlow Lite) to analyze car problems through photos and descriptions.\n                            </p>\n                        </section>\n                        <section class=\"border-t border-[#30363D] pt-8\" data-kid=\"1-1-2-1-3-2-4\" data-name=\"features section\" id=\"features\">\n                            <div class=\"mb-5 flex items-center gap-3\" data-kid=\"1-1-2-1-3-2-4-1\" data-name=\"section header\">\n                                <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-4-1-1\" data-name=\"section number\">\n                                    04\n                                </span>\n                                <h2 class=\"text-xl font-semibold tracking-[-0.02em] text-[#F0F6FC]\" data-kid=\"1-1-2-1-3-2-4-1-2\" data-name=\"section title\">\n                                    Features\n                                </h2>\n                            </div>\n                            <ul class=\"grid gap-3 sm:grid-cols-2\" data-kid=\"1-1-2-1-3-2-4-2\" data-name=\"features list\">\n                                <li class=\"flex items-start gap-3 rounded-md border border-[#30363D] bg-[#161B22] p-3 text-sm text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-4-2-1\" data-name=\"feature item 1\">\n                                    <span class=\"mt-0.5 font-['JetBrains_Mono',monospace] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-4-2-1-1\" data-name=\"checkmark icon\">\n                                        ✓\n                                    </span>\n                                    AI-powered diagnostics\n                                </li>\n                                <li class=\"flex items-start gap-3 rounded-md border border-[#30363D] bg-[#161B22] p-3 text-sm text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-4-2-2\" data-name=\"feature item 2\">\n                                    <span class=\"mt-0.5 font-['JetBrains_Mono',monospace] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-4-2-2-1\" data-name=\"checkmark icon\">\n                                        ✓\n                                    </span>\n                                    Photo-based analysis\n                                </li>\n                                <li class=\"flex items-start gap-3 rounded-md border border-[#30363D] bg-[#161B22] p-3 text-sm text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-4-2-3\" data-name=\"feature item 3\">\n                                    <span class=\"mt-0.5 font-['JetBrains_Mono',monospace] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-4-2-3-1\" data-name=\"checkmark icon\">\n                                        ✓\n                                    </span>\n                                    Real-time results with Gemini API\n                                </li>\n                                <li class=\"flex items-start gap-3 rounded-md border border-[#30363D] bg-[#161B22] p-3 text-sm text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-4-2-4\" data-name=\"feature item 4\">\n                                    <span class=\"mt-0.5 font-['JetBrains_Mono',monospace] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-4-2-4-1\" data-name=\"checkmark icon\">\n                                        ✓\n                                    </span>\n                                    Offline capabilities with TensorFlow Lite\n                                </li>\n                            </ul>\n                        </section>\n                        <section class=\"border-t border-[#30363D] pt-8\" data-kid=\"1-1-2-1-3-2-5\" data-name=\"role section\" id=\"role\">\n                            <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-2-1-3-2-5-1\" data-name=\"section header\">\n                                <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#3FB950]\" data-kid=\"1-1-2-1-3-2-5-1-1\" data-name=\"section number\">\n                                    05\n                                </span>\n                                <h2 class=\"text-xl font-semibold tracking-[-0.02em] text-[#F0F6FC]\" data-kid=\"1-1-2-1-3-2-5-1-2\" data-name=\"section title\">\n                                    Role\n                                </h2>\n                            </div>\n                            <div class=\"rounded-md border-l-2 border-[#7C7CFF] bg-[#161B22] px-4 py-3 font-['JetBrains_Mono',monospace] text-xs leading-6 text-[#8B949E]\" data-kid=\"1-1-2-1-3-2-5-2\" data-name=\"role text box\">\n                                Full-stack mobile developer — Architecture, AI integration, UI/UX\n                            </div>\n 