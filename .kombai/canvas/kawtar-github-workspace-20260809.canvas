ath>\n                            </svg>\n                            Open a collaboration\n                        </button>\n                    </div>\n                </div>\n            </article>\n            <aside class=\"relative min-w-0 bg-[#0F141B]\" data-kid=\"1-1-2-2\" data-name=\"sidebar column\">\n                <div class=\"sticky top-[57px] space-y-5 p-5 sm:p-8\" data-kid=\"1-1-2-2-1\" data-name=\"sidebar sticky content\">\n                    <div class=\"flex items-center justify-between font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E]\" data-kid=\"1-1-2-2-1-1\" data-name=\"asset header\">\n                        <span data-kid=\"1-1-2-2-1-1-1\" data-name=\"asset name\">\n                            product-preview / autobrain.png\n                        </span>\n                        <span class=\"text-[#3FB950]\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"asset type\">\n                            asset: real\n                        </span>\n                    </div>\n                    <div class=\"overflow-hidden rounded-xl border border-[#30363D] bg-[#0B121B]\" data-kid=\"1-1-2-2-1-2\" data-name=\"hero image container\">\n                        <img alt=\"AutoBrain project presentation showing AI automotive diagnostics mobile screens\" class=\"h-auto w-full object-cover\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"hero image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/autobrain.png\"/>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-3\" data-kid=\"1-1-2-2-1-3\" data-name=\"quick stats grid\">\n                        <div class=\"rounded-lg border border-[#30363D] bg-[#161B22] p-3\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"stat box 1\">\n                            <p class=\"mb-1 font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E]\" data-kid=\"1-1-2-2-1-3-1-1\" data-name=\"stat label\">\n                                runtime\n                            </p>\n                            <p class=\"font-['JetBrains_Mono',monospace] text-xs text-[#F0F6FC]\" data-kid=\"1-1-2-2-1-3-1-2\" data-name=\"stat value\">\n                                Android\n                            </p>\n                        </div>\n                        <div class=\"rounded-lg border border-[#30363D] bg-[#161B22] p-3\" data-kid=\"1-1-2-2-1-3-2\" data-name=\"stat box 2\">\n                            <p class=\"mb-1 font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E]\" data-kid=\"1-1-2-2-1-3-2-1\" data-name=\"stat label\">\n                                language\n                            </p>\n                            <p class=\"font-['JetBrains_Mono',monospace] text-xs text-[#F0F6FC]\" data-kid=\"1-1-2-2-1-3-2-2\" data-name=\"stat value\">\n                                Kotlin\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"border-t border-[#30363D] pt-5\" data-kid=\"1-1-2-2-1-4\" data-name=\"screen previews box\">\n                        <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-1-2-2-1-4-1\" data-name=\"previews header\">\n                            <h3 class=\"font-['JetBrains_Mono',monospace] text-xs text-[#F0F6FC]\" data-kid=\"1-1-2-2-1-4-1-1\" data-name=\"previews title\">\n                                screen preview\n                            </h3>\n                            <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E]\" data-kid=\"1-1-2-2-1-4-1-2\" data-name=\"previews range\">\n                                01—04\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-4 gap-2\" data-kid=\"1-1-2-2-1-4-2\" data-name=\"preview thumbnails grid\">\n                            <div class=\"rounded-[14px] border-4 border-[#0A0D12] bg-[#0A0D12] p-0.5\" data-kid=\"1-1-2-2-1-4-2-1\" data-name=\"thumbnail 1\">\n                                <img alt=\"AutoBrain Screen 01 preview\" class=\"h-28 w-full rounded-[10px] object-cover object-top\" data-kid=\"1-1-2-2-1-4-2-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/autobrain/screen1.png\"/>\n                            </div>\n                            <div class=\"rounded-[14px] border-4 border-[#0A0D12] bg-[#0A0D12] p-0.5\" data-kid=\"1-1-2-2-1-4-2-2\" data-name=\"thumbnail 2\">\n                                <img alt=\"AutoBrain Screen 02 preview\" class=\"h-28 w-full rounded-[10px] object-cover object-top\" data-kid=\"1-1-2-2-1-4-2-2-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/autobrain/screen2.png\"/>\n                            </div>\n                            <div class=\"rounded-[14px] border-4 border-[#0A0D12] bg-[#0A0D12] p-0.5\" data-kid=\"1-1-2-2-1-4-2-3\" data-name=\"thumbnail 3\">\n                                <img alt=\"AutoBrain Screen 03 preview\" class=\"h-28 w-full rounded-[10px] object-cover object-top\" data-kid=\"1-1-2-2-1-4-2-3-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/autobrain/screen3.png\"/>\n                            </div>\n                            <div class=\"rounded-[14px] border-4 border-[#0A0D12] bg-[#0A0D12] p-0.5\" data-kid=\"1-1-2-2-1-4-2-4\" data-name=\"thumbnail 4\">\n                                <img alt=\"AutoBrain Screen 04 preview\" class=\"h-28 w-full rounded-[10px] object-cover object-top\" data-kid=\"1-1-2-2-1-4-2-4-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/autobrain/screen4.png\"/>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"border-t border-[#30363D] pt-5\" data-kid=\"1-1-2-2-1-5\" data-name=\"sidebar repository signals\">\n                        <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-1-2-2-1-5-1\" data-name=\"signals header\">\n                            <h3 class=\"font-['JetBrains_Mono',monospace] text-xs text-[#F0F6FC]\" data-kid=\"1-1-2-2-1-5-1-1\" data-name=\"signals title\">\n                                repository signals\n                            </h3>\n                            <span class=\"font-['JetBrains_Mono',monospace] text-[10px] text-[#8B949E]\" data-kid=\"1-1-2-2-1-5-1-2\" data-name=\"signals status\">\n                                no fabricated metrics\n                            </span>\n                        </div>\n                        <div class=\"space-y-2 font-['JetBrains_Mono',monospace] text-[11px]\" data-kid=\"1-1-2-2-1-5-2\" data-name=\"signals grid\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-1-5-2-1\" data-name=\"signal row 1\">\n                                <span class=\"text-[#8B949E]\" data-kid=\"1-1-2-2-1-5-2-1-1\" data-name=\"signal label\">\n                                    type\n                                </span>\n                                <span class=\"text-[#F0F6FC]\" data-kid=\"1-1-2-2-1-5-2-1-2\" data-name=\"signal value\">\n                                    Mobile application\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-1-5-2-2\" data-name=\"signal row 2\">\n                                <span class=\"text-[#8B949E]\" data-kid=\"1-1-2-2-1-5-2-2-1\" data-name=\"signal label\">\n                                    focus\n                                </span>\n                                <span class=\"text-[#F0F6FC]\" data-kid=\"1-1-2-2-1-5-2-2-2\" data-name=\"signal value\">\n                                    AI diagnostics\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-1-5-2-3\" data-name=\"signal row 3\">\n                                <span class=\"text-[#8B949E]\" data-kid=\"1-1-2-2-1-5-2-3-1\" data-name=\"signal label\">\n                                    source\n                                </span>\n                                <span class=\"text-[#3FB950]\" data-kid=\"1-1-2-2-1-5-2-3-2\" data-name=\"signal value\">\n                                    available\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </aside>\n        </main>\n    </div>\n</div>\n",
