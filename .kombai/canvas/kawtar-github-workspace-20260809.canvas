ata-kid=\"1-2-2-6-1-3-4\">\n                            template: collaboration\n                            <br data-kid=\"1-2-2-6-1-3-4-1\"/>\n                            labels: mobile, ui/ux, product\n                            <br data-kid=\"1-2-2-6-1-3-4-2\"/>\n                            assignee: kawtar-elg\n                        </div>\n                    </div>\n                </div>\n                <div class=\"kw-panel p-7\" data-kid=\"1-2-2-6-2\">\n                    <div class=\"flex items-center justify-between border-b border-[#30363D] pb-4\" data-kid=\"1-2-2-6-2-1\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-6-2-1-1\">\n                            <span class=\"kw-mono rounded bg-[#1F2630] px-2 py-1 text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-1-1-1\">\n                                new issue\n                            </span>\n                            <span class=\"text-[12px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-1-1-2\">\n                                collaboration.md\n                            </span>\n                        </div>\n                        <span class=\"kw-mono text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-1-2\">\n                            write\n                        </span>\n                    </div>\n                    <form class=\"mt-5 grid grid-cols-2 gap-4\" data-kid=\"1-2-2-6-2-2\">\n                        <label class=\"block\" data-kid=\"1-2-2-6-2-2-1\">\n                            <span class=\"kw-mono mb-2 block text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-2-1-1\">\n                                title\n                            </span>\n                            <input class=\"kw-input w-full px-3 py-2.5 text-[13px]\" data-kid=\"1-2-2-6-2-2-1-2\" placeholder=\"I have a mobile app idea...\"/>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-2-2-6-2-2-2\">\n                            <span class=\"kw-mono mb-2 block text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-2-2-1\">\n                                email\n                            </span>\n                            <input class=\"kw-input w-full px-3 py-2.5 text-[13px]\" data-kid=\"1-2-2-6-2-2-2-2\" placeholder=\"you@example.com\" type=\"email\"/>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-2-2-6-2-2-3\">\n                            <span class=\"kw-mono mb-2 block text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-2-3-1\">\n                                project type\n                            </span>\n                            <select class=\"kw-input w-full px-3 py-2.5 text-[13px]\" data-kid=\"1-2-2-6-2-2-3-2\">\n                                <option data-kid=\"1-2-2-6-2-2-3-2-1\">\n                                    Mobile Application\n                                </option>\n                                <option data-kid=\"1-2-2-6-2-2-3-2-2\">\n                                    UI/UX Design\n                                </option>\n                                <option data-kid=\"1-2-2-6-2-2-3-2-3\">\n                                    AI Integration\n                                </option>\n                            </select>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-2-2-6-2-2-4\">\n                            <span class=\"kw-mono mb-2 block text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-2-4-1\">\n                                budget\n                                <span class=\"text-[#8B949E]/60\" data-kid=\"1-2-2-6-2-2-4-1-1\">\n                                    (optional)\n                                </span>\n                            </span>\n                            <input class=\"kw-input w-full px-3 py-2.5 text-[13px]\" data-kid=\"1-2-2-6-2-2-4-2\" placeholder=\"Optional\"/>\n                        </label>\n                        <label class=\"col-span-2 block\" data-kid=\"1-2-2-6-2-2-5\">\n                            <span class=\"kw-mono mb-2 block text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-2-5-1\">\n                                description\n                            </span>\n                            <textarea class=\"kw-input min-h-[92px] w-full resize-none px-3 py-2.5 text-[13px]\" data-kid=\"1-2-2-6-2-2-5-2\" placeholder=\"Tell me about your project...\"></textarea>\n                        </label>\n                        <div class=\"col-span-2 flex items-center justify-between\" data-kid=\"1-2-2-6-2-2-6\">\n                            <span class=\"kw-mono text-[10px] text-[#8B949E]\" data-kid=\"1-2-2-6-2-2-6-1\">\n                                Your message stays inside this workspace.\n                            </span>\n                            <button class=\"rounded-md bg-[#2EA043] px-4 py-2.5 text-[12px] font-semibold text-white hover:bg-[#3FB950]\" data-kid=\"1-2-2-6-2-2-6-2\" type=\"button\">\n                                Submit collaboration request\n                            </button>\n                        </div>\n                    </form>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n<script>\n    const cells = document.querySelectorAll('.kw-cell');\n  cells.forEach((cell, index) => { cell.style.opacity = index % 9 === 0 ? '0.95' : index % 4 === 0 ? '0.72' : '1'; });\n</script>\n",
