      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .kw-shell { font-family: 'Inter', sans-serif; background: #0D1117; color: #F0F6FC; min-height: 100vh; }\n  .kw-mono { font-family: 'JetBrains Mono', monospace; }\n  .kw-rail { width: 280px; background: #161B22; border-right: 1px solid #30363D; }\n  .kw-content { min-width: 0; }\n  .kw-panel { background: #161B22; border: 1px solid #30363D; border-radius: 14px; }\n  .kw-panel-raised { background: #1F2630; border: 1px solid #30363D; border-radius: 10px; }\n  .kw-rule { border-color: #30363D; }\n  .kw-link:hover { color: #3FB950; }\n  .kw-tab:hover { color: #F0F6FC; background: #1F2630; }\n  .kw-repo:hover { border-color: #7C7CFF; transform: translateY(-2px); }\n  .kw-repo:hover .kw-preview { transform: scale(1.025); }\n  .kw-repo, .kw-preview, .kw-link, .kw-tab { transition: all 240ms cubic-bezier(.2,0,0,1); }\n  .kw-phone { border: 5px solid #0a0d12; border-radius: 24px; box-shadow: 0 14px 34px rgba(0,0,0,.45), 0 0 0 1px rgba(240,246,252,.1); overflow: hidden; background: #0b1017; }\n  .kw-phone img { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .kw-dots { background-image: radial-gradient(#30363D 1px, transparent 1px); background-size: 16px 16px; opacity: .36; }\n  .kw-grid { display: grid; grid-template-columns: repeat(20, 1fr); gap: 4px; }\n  .kw-cell { aspect-ratio: 1; border-radius: 2px; background: #1F2630; }\n  .kw-cell.g1 { background: #0e4429; } .kw-cell.g2 { background: #006d32; } .kw-cell.g3 { background: #26a641; } .kw-cell.g4 { background: #3fb950; }\n  .kw-input { background: #0D1117; border: 1px solid #30363D; color: #F0F6FC; border-radius: 6px; outline: none; }\n  .kw-input:focus { border-color: #7C7CFF; box-shadow: 0 0 0 3px rgba(124,124,255,.16); }\n  @media (max-width: 980px) { .kw-rail { width: 232px; } .kw-repo-grid { grid-template-columns: 1fr !important; } .kw-readme-grid { grid-template-columns: 1fr !important; } }\n  @media (max-width: 700px) { .kw-layout { display: block !important; } .kw-rail { width: 100%; border-right: 0; border-bottom: 1px solid #30363D; } .kw-rail-inner { position: static !important; } .kw-profile-row { display: flex; align-items: center; gap: 14px; } .kw-profile-copy { min-width: 0; } .kw-nav { display: flex; overflow-x: auto; } .kw-nav a { white-space: nowrap; } .kw-topbar { flex-wrap: wrap; } .kw-topbar-search { flex: 1 1 100%; order: 3; } .kw-content-inner { padding: 20px !important; } .kw-collab-grid { grid-template-columns: 1fr !important; } }\n</style>\n<div class=\"kw-shell kw-layout flex\" data-kid=\"1\">\n    <aside class=\"kw-rail shrink-0\" data-kid=\"1-1\">\n        <div class=\"kw-rail-inner sticky top-0 flex min-h-screen flex-col p-6\" data-kid=\"1-1-1\">\n            <div class=\"kw-profile-row\" data-kid=\"1-1-1-1\">\n                <div class=\"relative shrink-0\" data-kid=\"1-1-1-1-1\">\n                    <img alt=\"Kawtar El Gaddi\" class=\"h-16 w-16 rounded-full border border-[#30363D] object-cover\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/kawtar-profile.jpeg\"/>\n                    <span class=\"absolute bottom-0 right-0 h-4 w-4 rounded-full border-[3px] border-[#161B22] bg-[#3FB950]\" data-kid=\"1-1-1-1-1-2\">\n                    </span>\n                </div>\n                <div class=\"kw-profile-copy mt-4\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"kw-mono text-[11px] text-[#8B949E]\" data-kid=\"1-1-1-1-2-1\">\n                        >_ kawtar-elg\n                    </div>\n                    <h1 class=\"mt-1 text-[18px] font-semibold tracking-[-.3px] text-[#F0F6FC]\" data-kid=\"1-1-1-1-2-2\">\n                        Kawtar El Gaddi\n                    </h1>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#8B949E]\" data-kid=\"1-1-1-1-2-3\">\n                      