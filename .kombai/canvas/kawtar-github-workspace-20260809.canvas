      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  :root {\n    --canvas: #0D1117;\n    --surface: #161B22;\n    --raised: #1F2630;\n    --hairline: #30363D;\n    --ink: #F0F6FC;\n    --muted: #8B949E;\n    --green: #2EA043;\n    --green-bright: #3FB950;\n    --indigo: #7C7CFF;\n  }\n  html { background: var(--canvas); }\n  body { margin: 0; min-width: 320px; background: var(--canvas); color: var(--ink); font-family: 'Inter', sans-serif; }\n  .mono { font-family: 'JetBrains Mono', monospace; }\n  .hairline { border-color: var(--hairline); }\n  .scrollbar-none::-webkit-scrollbar { display: none; }\n  .scrollbar-none { scrollbar-width: none; }\n  .repo-row:hover { border-color: rgba(124,124,255,.75); background: rgba(31,38,48,.84); }\n  .repo-row:hover .preview-frame { transform: translateY(-3px); border-color: rgba(63,185,80,.6); }\n  .preview-frame { transition: transform 240ms cubic-bezier(.2,0,0,1), border-color 240ms cubic-bezier(.2,0,0,1); }\n  .filter-chip[data-active='true'] { color: #F0F6FC; border-color: rgba(124,124,255,.9); background: rgba(124,124,255,.14); }\n  .branch-stem::before { content: ''; position: absolute; left: 18px; top: 34px; bottom: -34px; width: 1px; background: var(--hairline); }\n  .branch-stem:last-child::before { display: none; }\n  @media (prefers-reduced-motion: reduce) { .preview-frame { transition: none; } }\n</style>\n<div class=\"min-h-screen overflow-x-clip bg-[#0D1117] text-[#F0F6FC]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"pointer-events-none fixed -left-28 top-28 h-72 w-72 rounded-full bg-[#7C7CFF]/[0.045] blur-3xl\" data-kid=\"1-1\" data-name=\"decorative background blur orb\">\n    </div>\n    <div class=\"pointer-events-none fixed bottom-0 right-0 h-96 w-96 rounded-full bg-[#2EA043]/[0.035] blur-3xl\" data-kid=\"1-2\" data-name=\"decorative background blur orb\">\n    </div>\n    <div class=\"relative mx-auto flex min-h-screen max-w-[1500px]\" data-kid=\"1-3\" data-name=\"main page content area\">\n        <aside class=\"hidden w-[252px] shrink-0 border-r border-[#30363D] bg-[#11161D] px-5 py-6 lg:flex lg:flex-col\" data-kid=\"1-3-1\" data-name=\"sidebar navigation panel\">\n            <div class=\"flex items-center gap-3 border-b border-[#30363D] pb-6\" data-kid=\"1-3-1-1\" data-name=\"profile summary container\">\n                <div class=\"relative h-11 w-11 overflow-hidden rounded-xl border border-[#30363D] bg-[#1F2630]\" data-kid=\"1-3-1-1-1\" data-name=\"profile portrait image container\">\n                    <img alt=\"Kawtar El Gaddi profile portrait\" class=\"h-full w-full object-cover\" data-kid=\"1-3-1-1-1-1\" data-name=\"profile portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/kawtar-profile.jpeg\"/>\n                    <span class=\"absolute bottom-0.5 right-0.5 h-2.5 w-2.5 rounded-full border-2 border-[#11161D] bg-[#3FB950]\" data-kid=\"1-3-1-1-1-2\" data-name=\"profile online status indicator\">\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-3-1-1-2\" data-name=\"profile identity text\">\n                    <p class=\"truncate text-[13px] font-semibold text-[#F0F6FC]\" data-kid=\"1-3-1-1-2-1\" data-name=\"profile name text\">\n                        Kawtar El Gaddi\n                    </p>\n                    <p class=\"mono mt-1 truncate text-[10px] text-[#8B949E]\" data-kid=\"1-3-1-1-2-2\" data-name=\"profile handle text\">\n                        @Kawtar-Elg\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-6 rounded-lg border border-[#30363D] bg-[#161B22] p-3\" data-kid=\"1-3-1-2\" data-name=\"status update card\">\n                <div class=\"flex items-center gap-2 text-[11px] text-[#8B949E]\" data-kid=\"1-3-1-2-1\" data-name=\"status label\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#3FB950]\" data-kid=\"1-3-1-2-1-1\" data-name=\"status active dot\">\n                    </span>\n                    <span class=\"mono\" data-kid=\"1-3-1-2-1-2\" data-name=\"status label text\">\n                        status\n                    </span>\n                </div>\n                <p class=\"mt-2 text-[12px] leading-5 text-[#F0F6FC]\" data-kid=\"1-3-1-2-2\" data-name=\"status description text\">\n                    Mobile Application Developer · UI/UX Designer\n                </p>\n            </div>\n            <nav aria-label=\"Workspace navigation\" class=\"mt-7 space-y-1\" data-kid=\"1-3-1-3\" data-name=\"workspace navigation list\">\n                <p class=\"mono mb-3 px-3 text-[10px] uppercase tracking-[0.18em] text-[#8B949E]\" data-kid=\"1-3-1-3-1\" data-name=\"navigation group label\">\n                    workspace\n                </p>\n                <a class=\"flex items-center gap-3 rounded-md px-3 py-2.5 text-[13px] text-[#8B949E] hover:bg-[#1F2630] hover:text-[#F0F6FC]\" data-kid=\"1-3-1-3-2\" data-name=\"overview navigation link\" href=\"#overview\">\n                    <i class=\"h-4 w-4 text-[#8B949E]\" data-kid=\"1-3-1-3-2-1\" data-lucide=\"layout-dashboard\" data-name=\"overview icon\">\n                    </i>\n                    Overview\n                </a>\n                <a class=\"flex items-center gap-3 rounded-md border-l-2 border-[#7C7CFF] bg-[#7C7CFF]/10 px-3 py-2.5 text-[13px] font-medium text-[#F0F6FC]\" data-kid=\"1-3-1-3-3\" data-name=\"repositories navigation link\" href=\"#repositories\">\n                    <i class=\"h-4 w-4 text-[#7C7CFF]\" data-kid=\"1-3-1-3-3-1\" data-lucide=\"book-marked\" data-name=\"repositories icon\">\n                    </i>\n                    Repositories\n                    <span class=\"mono ml-auto text-[10px] text-[#7C7CFF]\" data-kid=\"1-3-1-3-3-2\" data-name=\"repositories count badge\">\n                        11\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 rounded-md px-3 py-2.5 text-[13px] text-[#8B949E] hover:bg-[#1F2630] hover:text-[#F0F6FC]\" data-kid=\"1-3-1-3-4\" data-name=\"activity navigation link\" href=\"#activity\">\n                    <i class=\"h-4 w-4 text-[#8B949E]\" data-kid=\"1-3-1-3-4-1\" data-lucide=\"activity\" data-name=\"activity icon\">\n                    </i>\n                    Activity\n                </a>\n                <a class=\"flex items-center gap-3 rounded-md px-3 py-2.5 text-[13px] text-[#8B949E] hover:bg-[#1F2630] hover:text-[#F0F6FC]\" data-kid=\"1-3-1-3-5\" data-name=\"achievements navigation link\" href=\"#achievements\">\n                    <i class=\"h-4 w-4 text-[#8B949E]\" data-kid=\"1-3-1-3-5-1\" data-lucide=\"award\" data-name=\"achievements icon\">\n                    </i>\n                    Achievements\n                </a>\n                <a class=\"flex items-center gap-3 rounded-md px-3 py-2.5 text-[13px] text-[#8B949E] hover:bg-[#1F2630] hover:text-[#F0F6FC]\" data-kid=\"1-3-1-3-6\" data-name=\"skills navigation link\" href=\"#skills\">\n                    <i class=\"h-4 w-4 text-[#8B949E]\" data-kid=\"1-3-1-3-6-1\" data-lucide=\"layers-3\" data-name=\"skills icon\">\n                    </i>\n                    Skills\n                </a>\n            </nav>\n            <div class=\"mt-auto space-y-3 border-t border-[#30363D] pt-5\" data-kid=\"1-3-1-4\" data-name=\"connect section\">\n                <p class=\"mono text-[10px] uppercase tracking-[0.18em] text-[#8B949E]\" data-kid=\"1-3-1-4-1\" data-name=\"connect section label\">\n                    connect\n                </p>\n                <a class=\"flex items-center gap-2 text-[12px] text-[#8B949E] hover:text-[#3FB950]\" data-kid=\"1-3-1-4-2\" data-name=\"github link\" href=\"https://github.com/Kawtar-Elg\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-3-1-4-2-1\" data-lucide=\"github